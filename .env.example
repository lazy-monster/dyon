# Dyon environment configuration
# Copy this file to .env and fill in your values.
# Nested sub-config fields use double-underscore as delimiter.

# ── Asset identity ──────────────────────────────────────────────────────────
DT_ASSET_ID=asset_001
DT_ASSET_TYPE=generic_asset
DT_ASSET_NAME=My Asset

# ── MQTT ────────────────────────────────────────────────────────────────────
DT_MQTT__BROKER=localhost
DT_MQTT__PORT=1883
# DT_MQTT__USERNAME=                 # set to disable anonymous broker access
# DT_MQTT__PASSWORD=
# DT_MQTT__TLS=false                 # true (with PORT=8883) to encrypt broker traffic
# DT_MQTT__TLS_CA_CERTS=             # CA bundle path; empty = system default CAs
# DT_MQTT__TLS_INSECURE=false        # skip hostname verification (test brokers only)

# ── InfluxDB ─────────────────────────────────────────────────────────────────
DT_INFLUX__URL=http://localhost:8086
DT_INFLUX__TOKEN=my-super-secret-token
DT_INFLUX__ORG=digital_twin
DT_INFLUX__BUCKET=asset_telemetry

# ── MongoDB ──────────────────────────────────────────────────────────────────
DT_MONGO__URI=mongodb://admin:password@localhost:27017
DT_MONGO__DB=digital_twin

# ── Redis ────────────────────────────────────────────────────────────────────
DT_REDIS__URL=redis://localhost:6379

# ── MinIO ────────────────────────────────────────────────────────────────────
DT_MINIO__ENDPOINT=localhost:9000
DT_MINIO__ACCESS_KEY=minioadmin
DT_MINIO__SECRET_KEY=minioadmin

# ── Eclipse Ditto ─────────────────────────────────────────────────────────────
DT_DITTO__URL=http://localhost:8080
DT_DITTO__USER=ditto
DT_DITTO__PASSWORD=ditto
DT_DITTO__NAMESPACE=org.example

# ── Neo4j ────────────────────────────────────────────────────────────────────
DT_NEO4J__URI=bolt://localhost:7687
DT_NEO4J__USER=neo4j
DT_NEO4J__PASSWORD=password

# ── LLM (intelligent layer) ──────────────────────────────────────────────────
DT_LLM__PROVIDER=openai
DT_LLM__MODEL=gpt-4o-mini
DT_LLM__API_KEY=sk-...
# DT_LLM__BASE_URL=http://localhost:11434   # required for "ollama" / custom deployments
# DT_LLM__TEMPERATURE=0.0
# DT_LLM__TIMEOUT_S=60.0             # per-request timeout
# DT_LLM__MAX_TOKENS=2048            # response cap (Ollama: num_predict)
# DT_LLM__MAX_RETRIES=2             # client-level retries on transient errors

# ── Security posture ─────────────────────────────────────────────────────────
# Dev mode (the default) is open: default credentials, open CORS, no API key —
# safe only on a trusted local network. For anything exposed, set mode=production
# (the twin then refuses to start with insecure defaults), an API key, and the
# allowed CORS origins. See SECURITY.md.
# DT_SECURITY__MODE=dev                              # "dev" | "production"
# DT_SECURITY__API_KEY=                              # non-empty => all /api/* routes require it
# DT_SECURITY__CORS_ORIGINS=["https://dash.example.com"]

# ── API server ───────────────────────────────────────────────────────────────
# Binds localhost by default; set 0.0.0.0 explicitly (with an API key) to expose.
DT_API_HOST=127.0.0.1
DT_API_PORT=8500
